# Copy this file to .env and fill in your real values.
# NEVER commit the .env file — it contains secrets.

# ---------------------------------------------------------------------------
# AWS configuration
# ---------------------------------------------------------------------------
# Which AWS data center region to deploy to.
AWS_REGION=us-east-1
# Your 12-digit AWS account number. Leave blank in the example.
AWS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# S3
# ---------------------------------------------------------------------------
# Bucket for storing user photos and processed images.
# S3 bucket names are globally unique across all AWS accounts. Suffix with your
# 12-digit account ID to avoid collisions (e.g. glow-up-app-assets-123456789012).
S3_BUCKET_NAME=glow-up-app-assets

# ---------------------------------------------------------------------------
# DynamoDB
# ---------------------------------------------------------------------------
# Table for user data and sessions.
DYNAMODB_TABLE_NAME=glow-up-app-users

# ---------------------------------------------------------------------------
# CloudFront
# ---------------------------------------------------------------------------
# Leave blank — filled in after infrastructure deploy.
CLOUDFRONT_DISTRIBUTION_ID=

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# S3 bucket for remote Terraform state storage.
# S3 bucket names are globally unique across all AWS accounts. Suffix with your
# 12-digit account ID to avoid collisions (e.g. glow-up-app-tf-state-123456789012).
TF_STATE_BUCKET=glow-up-app-tf-state
# Region for the state bucket.
TF_STATE_REGION=us-east-1

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Lambda API endpoint. Leave blank — filled in after infrastructure deploy.
VITE_API_URL=
# CloudFront URL for the frontend. Leave blank — filled in after infrastructure deploy.
VITE_CLOUDFRONT_URL=
