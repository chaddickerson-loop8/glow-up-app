# Regenerated from package.json via npm install. Never commit.
# Dependencies
node_modules/
.pnp
.pnp.js

# Compiled code regenerated by build commands. Never commit.
# Build outputs
build/
dist/
.next/
out/

# Contains secrets, API keys, and credentials. NEVER commit. Security critical.
# Environment and secrets
.env
.env.local
.env.*.local

# Machine-specific editor settings. Not project code.
# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# OS-generated junk files.
# Operating system
.DS_Store
Thumbs.db

# Terraform state contains sensitive infrastructure data. State must be stored in
# remote S3 backend, never in Git. tfvars may contain account-specific sensitive values.
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl
terraform.tfvars

# Runtime logs. Not project code.
# Logs
*.log
npm-debug.log*

# Generated test reports. Regenerated on each test run.
# Test coverage
coverage/
