{
  "project": "glow-up-app",
  "model": "claude-opus-4-6",
  "permissions": {
    "allow_file_create": true,
    "allow_file_edit": true,
    "allow_bash": true,
    "allow_network": false
  },
  "context": [
    "CLAUDE.md",
    "PROJECT_STATUS.xml"
  ],
  "conventions": {
    "commit_format": "conventional",
    "code_style": "eslint",
    "documentation": "always"
  },
  "git": {
    "default_branch": "develop",
    "protected_branches": ["main"],
    "push_to_main": false,
    "require_verification_before_push": true
  }
}
